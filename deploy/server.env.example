LUMEN_PUBLIC_ORIGIN=https://night.example.com
LUMEN_HOST=127.0.0.1
PORT=5180
LUMEN_TRUST_PROXY=1
LUMEN_PROXY_IP_HEADER=x-lumen-client-ip
LUMEN_CACHE_DIR=/var/lib/lumen-streets/maps
LUMEN_PHOTON_URL=https://photon.komoot.io/api/
LUMEN_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Shared upstream allowances per UTC day; cached results do not consume them.
LUMEN_SEARCH_DAILY_LIMIT=1000
LUMEN_MAP_DAILY_LIMIT=300
# Both cache capacity and the daily upstream download budget, in decimal MB.
LUMEN_CACHE_MB=512

# Shared global building cache and preinstalled Python runtime.
LUMEN_BUILDINGS_CACHE_DIR=/var/lib/lumen-streets/buildings
LUMEN_BUILDINGS_PYTHON=/srv/lumen-streets/current/.cache/building-venv/bin/python
