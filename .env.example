# Copy to .env for npm start. For a public server, see docs/HOSTING.md.
# The default listener and origin are http://127.0.0.1:5180.
LUMEN_PUBLIC_ORIGIN=http://127.0.0.1:5180
# Build-time social/canonical URL. Include the subpath when hosting below a directory.
# Set in an ignored .env.production.local on the BUILD machine; rebuild after changing it.
# Defaults to the official demo. Independent hosts should set their own public URL.
# LUMEN_SITE_URL=https://night.example.com/
LUMEN_HOST=127.0.0.1
PORT=5180
LUMEN_TRUST_PROXY=0
# Used only with a trusted proxy on the same machine. For cloudflared use cf-connecting-ip.
LUMEN_PROXY_IP_HEADER=x-lumen-client-ip
# Optional administrator-controlled HTTPS endpoints, also read by dev/preview.
# Never put credentials into a VITE_ value: those values are public browser code.
LUMEN_PHOTON_URL=https://photon.komoot.io/api/
LUMEN_OVERPASS_URL=https://overpass-api.de/api/interpreter
# For a different tile source, update its attribution in src/search/ui.js as well.
VITE_LUMEN_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Main 3D vector source, using the OpenMapTiles schema (build-time public URL).
# VITE_LUMEN_TILEJSON_URL=https://tiles.openfreemap.org/planet
# Global building service runs automatically with npm dev/start/preview.
# Optional administrator-selected Python environment (never a visitor input).
# LUMEN_BUILDINGS_PYTHON=/opt/lumen/.cache/building-venv/bin/python
