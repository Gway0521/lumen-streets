{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "ESNext.Disposable"],
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src/scene/**/*.ts", "src/engine/**/*.ts", "src/export/**/*.ts", "src/search/**/*.ts", "src/player/**/*.ts"]
}
