{
  "name": "lumen-streets",
  "version": "0.3.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Turn real streets into living nightscapes.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "npm run check:types && npm run check:landmarks && vite build && node scripts/package-source.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "test": "node --test tests/*.test.js",
    "check:presets": "node scripts/check-presets.mjs",
    "check:landmarks": "node scripts/check-landmarks.mjs && node scripts/check-landmarks-v2.mjs",
    "prepare:landmarks": "node scripts/check-landmarks.mjs --write && node scripts/check-landmarks-v2.mjs --write",
    "fetch:landmarks": "node scripts/fetch-landmark-candidates.mjs",
    "check:types": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "check:release": "node scripts/check-release.mjs",
    "pack:site": "npm run build && node scripts/package-site.mjs",
    "pack:release": "npm run pack:site && node scripts/package-release.mjs",
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "dev:3d": "vite --host 127.0.0.1 --port 5183 --strictPort --open /three.html",
    "check:3d": "node --test tests/three.test.js",
    "check:3d:browser": "node scripts/check-3d-browser.mjs",
    "check:3d:capture": "node scripts/check-3d-capture.mjs",
    "setup:buildings": "node --env-file-if-exists=.env scripts/setup-buildings.mjs",
    "predev": "npm run setup:buildings",
    "prestart": "npm run setup:buildings",
    "prepreview": "npm run setup:buildings"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "earcut": "3.2.3",
    "gifenc": "1.0.3",
    "leaflet": "1.9.4",
    "maplibre-gl": "6.9.1",
    "mediabunny": "1.56.1",
    "pbf": "5.1.2",
    "pmtiles": "4.5.0",
    "polygon-clipping": "0.15.7",
    "three": "0.186.0"
  }
}
