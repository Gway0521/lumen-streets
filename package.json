{
  "name": "lumen-streets",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "Turn real streets into living nightscapes.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "npm run check:types && vite build && node scripts/package-source.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "test": "node --test tests/*.test.js",
    "check:presets": "node scripts/check-presets.mjs",
    "check:types": "tsc --noEmit",
    "check:release": "node scripts/check-release.mjs",
    "pack:site": "npm run build && node scripts/package-site.mjs",
    "start": "node --env-file-if-exists=.env server/start.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "gifenc": "1.0.3",
    "leaflet": "1.9.4",
    "mediabunny": "1.56.1"
  }
}
